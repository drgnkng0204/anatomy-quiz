rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 共有中ユーザーの成績(名前・統計のみ。誰でも読める)
    match /profiles/{id} {
      allow read: if true;
      allow create, update: if id.size() >= 16 && id.size() <= 40
        && request.resource.data.keys().hasOnly(['name', 'stats', 'updated', 'hidden'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.stats is string && request.resource.data.stats.size() < 8000
        && request.resource.data.updated is string
        && request.resource.data.hidden is string;
      allow delete: if false;
    }

    // 各ユーザーの解答履歴(ユーザーIDを知っている場合のみ取得可。一覧は不可)
    match /records/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if id.size() >= 16 && id.size() <= 40
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string && request.resource.data.data.size() < 900000
        && request.resource.data.updated is string;
      allow delete: if false;
    }
  }
}
